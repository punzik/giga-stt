# PyPI wheels of the PyTorch and silero-vad CUDA stack that have no nixpkgs equivalents.
# Generated by a script from the PyPI JSON API (exact wheels, verified in a venv):
# for each package the single linux x86_64 wheel with the required tag is taken.
{
  lib,
  fetchurl,
  python3Packages,
}:
let
  mkWheel = name: version: attrs:
    python3Packages.buildPythonPackage {
      inherit name version;
      format = "wheel";
      src = fetchurl attrs;
      # the wheels are already built; pip-style checks are not needed:
      # the wheel's runtime dependencies are pulled in as separate derivation packages
      dontCheckRuntimeDeps = true;
      doCheck = false;
      pythonImportsCheck = [ ];
    };
in
